---
/**
 * Une carte de la grille : image, titre, bloc de métadonnées.
 * Comme MetaBlock, elle ignore le type de l'élément.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import MetaBlock from './MetaBlock.astro';
import type { Meta } from '~/lib/meta';

interface Props {
  href: string;
  title: string;
  image: { src: ImageMetadata; alt: string };
  meta: Meta;
  /** Les premières cartes, visibles sans défiler, ne sont pas chargées en différé. */
  priority?: boolean;
}

const { href, title, image, meta, priority = false } = Astro.props;
---

<article class="card">
  <a class="card__media" href={href} tabindex="-1" aria-hidden="true">
    <Picture
      src={image.src}
      alt=""
      formats={['avif', 'webp']}
      widths={[480, 720, 960, 1440]}
      sizes="(min-width: 72rem) 30vw, (min-width: 44rem) 46vw, 100vw"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  </a>
  <h2 class="card__title">
    <a href={href}>{title}</a>
  </h2>
  <MetaBlock fields={meta} />
</article>

<style>
  /* La carte reprend les trois rangées de la grille parente (subgrid) :
     dans une même rangée de cartes, titres et blocs de métadonnées
     commencent tous à la même hauteur, quelle que soit l'image. */
  .card {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: 0;
  }

  .card__media {
    align-self: end;
    display: block;
  }

  .card__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--paper-deep);
  }

  .card__title {
    margin: 1.1rem 0 0.6rem;
    font-family: var(--font-serif);
    font-size: var(--card-title-size);
    font-weight: 500;
    font-variation-settings: 'opsz' 96;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .card__title a {
    color: inherit;
    text-decoration: none;
  }

  .card__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }
</style>
