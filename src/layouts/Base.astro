---
import '~/styles/global.css';
import { SITE_NAME } from '~/lib/site';

interface Props {
  title?: string;
  description?: string;
  /** L'accueil affiche le nom en très grand : inutile de le répéter en tête. */
  showName?: boolean;
}

const { title, description = 'Photographies et programmes.', showName = true } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2f0ea" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      {showName ? <a class="site-name" href="/">{SITE_NAME}</a> : <span />}
      <nav aria-label="Principale">
        <ul>
          <li><a href="/a-propos">À propos</a></li>
          <li><a href="/a-propos#contact">Contact</a></li>
        </ul>
      </nav>
    </header>
    <main id="contenu">
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    max-width: var(--page-max);
    margin-inline: auto;
    padding: clamp(1rem, 2.5vw, 1.75rem) var(--gutter) 0;
    font-size: var(--meta-size);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .site-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0;
    text-transform: none;
    text-decoration: none;
  }

  nav ul {
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    text-decoration: none;
  }

  nav a:hover,
  .site-name:hover {
    color: var(--signal);
  }

  main {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: 0 var(--gutter) clamp(4rem, 10vw, 8rem);
  }
</style>
