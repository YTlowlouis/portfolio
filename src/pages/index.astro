---
import Base from '~/layouts/Base.astro';
import WorkCard from '~/components/WorkCard.astro';
import { getWorks, workHref } from '~/lib/works';
import { toMeta } from '~/lib/meta';

const works = await getWorks();
---

<Base>
  <h1 class="intro">Photographies et programmes, décrits de la même façon.</h1>

  <div class="grid">
    {
      works.map((work, index) => (
        <WorkCard
          href={workHref(work)}
          title={work.data.title}
          image={work.data.cover}
          meta={toMeta(work)}
          priority={index < 3}
        />
      ))
    }
  </div>
</Base>

<style>
  .intro {
    max-width: 14ch;
    margin: clamp(3rem, 10vw, 9rem) 0 clamp(3.5rem, 9vw, 8rem);
    font-family: var(--font-serif);
    font-size: var(--display-size);
    font-weight: 400;
    font-variation-settings: 'opsz' 96;
    line-height: 0.98;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  /* Trois rangées de grille par carte (image, titre, métadonnées),
     reprises par chaque carte en subgrid. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    column-gap: clamp(1.5rem, 4vw, 4rem);
    row-gap: clamp(3.5rem, 8vw, 6.5rem);
  }
</style>
